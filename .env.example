# Copy to .env and adjust. Every value below has a working default, so the
# stack runs with an empty .env - no API keys required.

# --- database ---------------------------------------------------------------
DATABASE_URL=postgres://triage:triage@localhost:5432/triage

# --- api --------------------------------------------------------------------
PORT=3000
# Leave empty to accept unauthenticated ingestion (fine for a local demo).
# Set a value and every POST /api/alerts must carry `x-api-key: <value>`.
INGEST_API_KEY=
# Two identical alerts inside this window count as one.
DEDUP_WINDOW_SEC=300

# --- worker -----------------------------------------------------------------
# mock | gemini | openai | anthropic
# `mock` is a deterministic offline keyword classifier - no network, no key.
LLM_PROVIDER=mock
WORKER_BATCH_SIZE=20
WORKER_POLL_SEC=3
LOG_LEVEL=INFO

# --- llm providers (only the one named in LLM_PROVIDER is read) --------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
